# Pinned native deployment inputs.
# Do not use a floating branch for a running server. Upgrade these values
# deliberately, then run the verification and gameplay smoke tests again.

FREEKILL_ASIO_RELEASE="0.1.17"
FREEKILL_ASIO_STATIC_URL="https://github.com/Qsgs-Fans/freekill-asio/releases/download/0.1.17/freekill-asio-static-0.1.17-amd64.tar.gz"
