# Pinned native deployment inputs.
# The package and patch values live in upstream-baseline.env, which is also
# read by the browser preparation tooling. Do not use a floating branch for a
# running server. Upgrade the baseline deliberately, then rerun all gates.

VERSIONS_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$VERSIONS_DIR/upstream-baseline.env"

FREEKILL_ASIO_RELEASE="$TQS_UPSTREAM_ASIO_RELEASE"
FREEKILL_ASIO_STATIC_URL="$TQS_UPSTREAM_ASIO_STATIC_URL"
FREEKILL_ASIO_STATIC_SHA256="$TQS_UPSTREAM_ASIO_STATIC_SHA256"

# The source commit for a future ARM64/source build.
FREEKILL_ASIO_SOURCE_URL="$TQS_UPSTREAM_ASIO_SOURCE_URL"
FREEKILL_ASIO_SOURCE_COMMIT="$TQS_UPSTREAM_ASIO_SOURCE_COMMIT"

FREEKILL_CORE_URL="$TQS_UPSTREAM_FREEKILL_CORE_URL"
FREEKILL_CORE_COMMIT="$TQS_UPSTREAM_FREEKILL_CORE_COMMIT"

UTILITY_URL="$TQS_UPSTREAM_UTILITY_URL"
UTILITY_COMMIT="$TQS_UPSTREAM_UTILITY_COMMIT"

HEGEMONY_URL="$TQS_UPSTREAM_HEGEMONY_URL"
HEGEMONY_COMMIT="$TQS_UPSTREAM_HEGEMONY_COMMIT"

# Virtual cards used by active overseas skills (for example
# enemy_at_the_gates and sincere_treat) live in the pinned gamemode package.
# Keep this package on the same exact revision in the native installer and the
# browser/runtime audit.
GAMEMODE_URL="$TQS_UPSTREAM_GAMEMODE_URL"
GAMEMODE_COMMIT="$TQS_UPSTREAM_GAMEMODE_COMMIT"

# Hegemony declares a number of skills owned by these extension repositories.
# Keep the dependency commits at or before the pinned Hegemony ref; using their
# moving masters would silently change the skill registry and package MD5.
STANDARD_EX_URL="$TQS_UPSTREAM_STANDARD_EX_URL"
STANDARD_EX_COMMIT="$TQS_UPSTREAM_STANDARD_EX_COMMIT"

SHZL_URL="$TQS_UPSTREAM_SHZL_URL"
SHZL_COMMIT="$TQS_UPSTREAM_SHZL_COMMIT"

YJ_URL="$TQS_UPSTREAM_YJ_URL"
YJ_COMMIT="$TQS_UPSTREAM_YJ_COMMIT"

MOBILE_URL="$TQS_UPSTREAM_MOBILE_URL"
MOBILE_COMMIT="$TQS_UPSTREAM_MOBILE_COMMIT"

SP_URL="$TQS_UPSTREAM_SP_URL"
SP_COMMIT="$TQS_UPSTREAM_SP_COMMIT"

TENYEAR_URL="$TQS_UPSTREAM_TENYEAR_URL"
TENYEAR_COMMIT="$TQS_UPSTREAM_TENYEAR_COMMIT"

OVERSEAS_URL="$TQS_UPSTREAM_OVERSEAS_URL"
OVERSEAS_COMMIT="$TQS_UPSTREAM_OVERSEAS_COMMIT"

MOUGONG_URL="$TQS_UPSTREAM_MOUGONG_URL"
MOUGONG_COMMIT="$TQS_UPSTREAM_MOUGONG_COMMIT"

JSRG_URL="$TQS_UPSTREAM_JSRG_URL"
JSRG_COMMIT="$TQS_UPSTREAM_JSRG_COMMIT"

OL_URL="$TQS_UPSTREAM_OL_URL"
OL_COMMIT="$TQS_UPSTREAM_OL_COMMIT"

FREEKILL_PORT="9527"
FREEKILL_INSTALL_ROOT="/opt/freekill-hegemony"
