[Unit]
Description=FreeKill Hegemony native server
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/freekill-hegemony/current

# The Ubuntu image ships a default INPUT reject after SSH. Keep the game
# ports open on reboot while leaving the admin HTTP port private.
ExecStartPre=/bin/sh -c '/usr/sbin/iptables -C INPUT -p tcp --dport 9527 -j ACCEPT 2>/dev/null || /usr/sbin/iptables -I INPUT 5 -p tcp --dport 9527 -j ACCEPT'
ExecStartPre=/bin/sh -c '/usr/sbin/iptables -C INPUT -p udp --dport 9527 -j ACCEPT 2>/dev/null || /usr/sbin/iptables -I INPUT 5 -p udp --dport 9527 -j ACCEPT'

# Keep the interactive FreeKill admin shell available in tmux.
ExecStart=/bin/sh -c '/usr/bin/tmux has-session -t freekill-native 2>/dev/null || /usr/bin/tmux new-session -d -s freekill-native /opt/freekill-hegemony/deploy/scripts/run-server.sh'
ExecStop=/bin/sh -c '/usr/bin/tmux has-session -t freekill-native 2>/dev/null && /usr/bin/tmux kill-session -t freekill-native || true'

[Install]
WantedBy=multi-user.target
