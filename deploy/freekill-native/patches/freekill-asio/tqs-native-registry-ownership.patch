 void RoomThread::delay(int roomId, int ms) {
-  emit_signal([=, this] { delay_callback(roomId, ms); });
+  auto &server = Server::instance();
+  auto room = server.room_manager().findRoom(roomId).lock();
+  auto task = server.task_manager().getTask(roomId);
+  if (!room && !task) return;
+  const auto session = room ? room->getSessionId() : 0;
+  emit_signal([this, roomId, ms, session, room = std::weak_ptr<Room>(room),
+               task = std::weak_ptr<Task>(task)] {
+    auto timer = std::make_shared<asio::steady_timer>(io_ctx, std::chrono::milliseconds(ms));
+    timer->async_wait([weak = weak_from_this(), roomId, session, room, task, timer](const std::error_code &ec) {
+      if (ec) return;
+      auto thread = weak.lock();
+      if (!thread || thread->shutdownScheduled.load()) return;
+      if (roomId > 0) {
+        auto current = room.lock();
+        if (!current || current->isRetired() || current->getSessionId() != session || !current->isStarted()) return;
+      } else {
+        auto current = task.lock();
+        if (!current || Server::instance().task_manager().getTask(roomId) != current) return;
+      }
+      thread->L->call("ResumeRoom", roomId, "delay_done"sv);
+      if (!thread->L->alive()) thread->scheduleShutdown();
+    });
+  });
 }
 
