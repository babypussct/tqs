+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <boost/asio.hpp>
+#include <chrono>
+#include <future>
+#include <memory>
+#include <mutex>
+#include <utility>
+
+// The main context can be stopped by the shell while a room worker is
+// waiting for a synchronous dispatch. Cancel queued work on shutdown, but
+// let an already-running callback finish before releasing the waiting worker.
+template <class Callback>
+void dispatchMainAndWait(boost::asio::io_context &context, Callback callback) {
+  if (context.stopped()) return;
+
+  struct State {
+    std::mutex mutex;
+    bool cancelled = false;
+  };
+  auto state = std::make_shared<State>();
+  auto future = boost::asio::dispatch(context, boost::asio::use_future(
+    [state, callback = std::move(callback)]() mutable {
+      std::lock_guard lock(state->mutex);
+      if (!state->cancelled) callback();
+    }));
+
+  while (future.wait_for(std::chrono::milliseconds(10)) != std::future_status::ready) {
+    if (context.stopped()) {
+      std::lock_guard lock(state->mutex);
+      state->cancelled = true;
+      return;
+    }
+  }
+}
