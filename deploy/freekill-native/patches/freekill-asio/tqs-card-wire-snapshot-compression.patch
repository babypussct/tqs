 #include "core/util.h"

+#include <cbor.h>
+
 namespace asio = boost::asio;

+namespace {
+
+constexpr size_t snapshotCompressionThreshold = 4096 - 24;
+constexpr size_t maxCompressedSnapshotInput = 8 * 1024 * 1024;
+constexpr std::string_view cardWireVersionKey = "cardWireVersion";
+
+bool isCardWireV1Snapshot(std::string_view payload) {
+  cbor_load_result result {};
+  auto *snapshot = cbor_load(
+    reinterpret_cast<const cbor_data>(payload.data()), payload.size(), &result);
+  if (!snapshot) return false;
+  bool v1 = false;
+  if (result.read == payload.size() && cbor_isa_map(snapshot) && cbor_map_size(snapshot) == 2) {
+    const auto *fields = cbor_map_handle(snapshot);
+    for (size_t i = 0; i < 2; ++i) {
+      const auto *key = fields[i].key;
+      const auto *value = fields[i].value;
+      // The native Lua CBOR codec encodes Lua string keys as byte strings.
+      if (cbor_isa_bytestring(key) && cbor_bytestring_is_definite(key) &&
+          cbor_bytestring_length(key) == cardWireVersionKey.size() &&
+          std::string_view(reinterpret_cast<const char *>(cbor_bytestring_handle(key)),
+                           cardWireVersionKey.size()) == cardWireVersionKey &&
+          cbor_isa_uint(value) && cbor_get_int(value) == 1) {
+        v1 = true;
+        break;
+      }
+    }
+  }
+  cbor_decref(&snapshot);
+  return v1;
+}
+
