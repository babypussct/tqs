+void RoomThread::scheduleShutdown() {
+  if (shutdownScheduled.exchange(true)) return;
+  // Finish any in-flight RPC dispatcher before the main context joins us.
+  // Dispatchers can synchronously wait for work on the main context.
+  asio::post(io_ctx, [this, weak = weak_from_this()] {
+    io_ctx.stop();
+    asio::post(Server::instance().context(), [weak] {
+      if (auto thread = weak.lock()) thread->shutdown();
+    });
+  });
+}
