+static void waitForPipe(asio::posix::stream_descriptor &file, short events,
+    std::chrono::steady_clock::time_point deadline) {
+  using namespace std::chrono;
+  pollfd descriptor {file.native_handle(), events, 0};
+  while (true) {
+    auto remaining = ceil<milliseconds>(deadline - steady_clock::now());
+    if (remaining <= milliseconds::zero()) throw boost::system::system_error(asio::error::timed_out);
+    int result = ::poll(&descriptor, 1, static_cast<int>(std::min<int64_t>(remaining.count(), INT_MAX)));
+    if (result > 0) return; // read/write reports EOF or other descriptor errors
+    if (result == 0) throw boost::system::system_error(asio::error::timed_out);
+    if (errno != EINTR) throw boost::system::system_error(errno, boost::system::generic_category());
+  }
+}
+
+size_t readRpcBytes(asio::posix::stream_descriptor &file, asio::mutable_buffer buffer,
+    std::chrono::milliseconds timeout) {
+  if (!file.non_blocking()) file.non_blocking(true);
+  const auto deadline = std::chrono::steady_clock::now() + timeout;
+  for (;;) {
+    waitForPipe(file, POLLIN, deadline);
+    boost::system::error_code ec;
+    auto size = file.read_some(buffer, ec);
+    if (!ec) return size;
+    if (ec != asio::error::would_block && ec != asio::error::try_again && ec != asio::error::interrupted)
+      throw boost::system::system_error(ec);
+  }
+}
+
+void writeRpcBytes(asio::posix::stream_descriptor &file, asio::const_buffer buffer,
+    std::chrono::milliseconds timeout) {
+  if (!file.non_blocking()) file.non_blocking(true);
+  auto deadline = std::chrono::steady_clock::now() + timeout;
+  while (buffer.size() > 0) {
+    waitForPipe(file, POLLOUT, deadline);
+    boost::system::error_code ec;
+    auto size = file.write_some(buffer, ec);
+    if (ec == asio::error::would_block || ec == asio::error::try_again || ec == asio::error::interrupted) continue;
+    if (ec) throw boost::system::system_error(ec);
+    if (size == 0) throw boost::system::system_error(asio::error::broken_pipe);
+    buffer += size;
+    deadline = std::chrono::steady_clock::now() + timeout;
+  }
+}
+
+// 传过去的算上call和返回值只有int bytes和null... 毁灭吧
+static void sendParam(asio::posix::stream_descriptor &file, JsonRpcParam &param) {
+  u_char buf[10]; size_t buflen;
+  std::visit([&](auto&& arg) {
+    using T = std::decay_t<decltype(arg)>;
+    if constexpr (std::is_same_v<T, int> || std::is_same_v<T, int64_t>) {
+      if (arg >= 0) {
+        buflen = cbor_encode_uint(arg, buf, 10);
+      } else {
+        buflen = cbor_encode_negint(-1-arg, buf, 10);
+      }
+      writeRpcBytes(file, asio::const_buffer(buf, buflen));
+    } else if constexpr (std::is_same_v<T, std::string_view> || std::is_same_v<T, std::string>) {
+      buflen = cbor_encode_uint(arg.size(), buf, 10);
+      buf[0] += 0x40;
+      writeRpcBytes(file, asio::const_buffer(buf, buflen));
+      writeRpcBytes(file, asio::const_buffer(arg.data(), arg.size()));
+    } else if constexpr (std::is_same_v<T, bool>) {
+      // F4: false; F5: true
+      writeRpcBytes(file, asio::const_buffer(arg ? "\xF5" : "\xF4", 1));
+    } else if constexpr (std::is_same_v<T, std::nullptr_t>) {
+      // F6: null (Lua中转为nil)
+      writeRpcBytes(file, asio::const_buffer("\xF6", 1));
+    }
+  }, param);
+}
+
+// request: { jsonRpc, method, params, id }
+void sendRequest(asio::posix::stream_descriptor &file, JsonRpcPacket &pkt) {
+  u_char buf[10]; size_t buflen;
+  if (pkt.param_count > 5) throw std::invalid_argument("Too many RPC parameters");
+  // { jsonRpc: '2.0', method: '
+  writeRpcBytes(file, asio::const_buffer("\xa4\x18\x64\x43" "2.0" "\x18\x65", 9));
+  buflen = cbor_encode_uint(pkt.method.size(), buf, 10);
+  buf[0] += 0x40;
+  // <method>',
+  writeRpcBytes(file, asio::const_buffer(buf, buflen));
+  writeRpcBytes(file, asio::const_buffer(pkt.method.data(), pkt.method.size()));
+  // id:
+  buflen = cbor_encode_uint(pkt.id, buf, 10);
+  writeRpcBytes(file, asio::const_buffer("\x18\x68", 2));
+  writeRpcBytes(file, asio::const_buffer(buf, buflen));
+  // params + arr head
+  size_t i = pkt.param_count;
+  buflen = cbor_encode_uint(i, buf, 10);
+  buf[0] += 0x80;
+  writeRpcBytes(file, asio::const_buffer("\x18\x66", 2));
+  writeRpcBytes(file, asio::const_buffer(buf, buflen));
+
+  if (i == 0) return;
+  sendParam(file, pkt.param1);
+  i--;
+
+  if (i == 0) return;
+  sendParam(file, pkt.param2);
+  i--;
+
+  if (i == 0) return;
+  sendParam(file, pkt.param3);
+  if (--i == 0) return;
+  sendParam(file, pkt.param4);
+  if (--i == 0) return;
+  sendParam(file, pkt.param5);
+}
+
+// response: { jsonRpc, result, id }
+void sendResponse(asio::posix::stream_descriptor &file, JsonRpcPacket &pkt) {
+  u_char buf[10]; size_t buflen;
+  // { jsonRpc: '2.0', id:
+  writeRpcBytes(file, asio::const_buffer("\xa3\x18\x64\x43" "2.0" "\x18\x68", 9));
+
+  // id
+  buflen = cbor_encode_uint(pkt.id, buf, 10);
+  writeRpcBytes(file, asio::const_buffer(buf, buflen));
+
+  // result
+  writeRpcBytes(file, asio::const_buffer("\x18\x69", 2));
+  sendParam(file, pkt.result);
+}
+
+// response: { jsonRpc, error, [id] }
+void sendError(asio::posix::stream_descriptor &file, JsonRpcPacket &pkt) {
+  u_char buf[10]; size_t buflen;
+
+  if (pkt.id < 0) {
+    writeRpcBytes(file, asio::const_buffer("\xa2", 1));
+  } else {
+    writeRpcBytes(file, asio::const_buffer("\xa3", 1));
+  }
+
+  // { jsonRpc: '2.0',
+  writeRpcBytes(file, asio::const_buffer("\x18\x64\x43" "2.0", 6));
+
+  // [id]
+  if (pkt.id >= 0) {
+    buflen = cbor_encode_uint(pkt.id, buf, 10);
+    writeRpcBytes(file, asio::const_buffer("\x18\x68", 2));
+    writeRpcBytes(file, asio::const_buffer(buf, buflen));
+  }
+
+  // error: { code:
+  writeRpcBytes(file, asio::const_buffer("\x18\x67\xA3\x18\xC8", 5));
+  buflen = cbor_encode_negint(-1 - static_cast<int64_t>(pkt.error.code), buf, 10);
+  writeRpcBytes(file, asio::const_buffer(buf, buflen));
+
+  // msg:
+  writeRpcBytes(file, asio::const_buffer("\x18\xC9", 2));
+  buflen = cbor_encode_uint(pkt.error.message.size(), buf, 10);
+  buf[0] += 0x40;
+  writeRpcBytes(file, asio::const_buffer(buf, buflen));
+  writeRpcBytes(file, asio::const_buffer(pkt.error.message.data(), pkt.error.message.size()));
+
+  // data:
+  writeRpcBytes(file, asio::const_buffer("\x18\xCA", 2));
+  sendParam(file, pkt.error.data);
+}
+
+// The largest client payload after native decompression is 8 MiB. Allow
+// additional RPC envelope/metadata while bounding malformed worker frames.
+constexpr size_t maxRpcPacketBytes = 16 * 1024 * 1024;
+
+struct RpcPacketBuilder {
+  enum State {
+    NOT_START,
+    WAIT_KEY,
+    WAIT_VALUE,
+    READING_PARAMS,
+    READING_ERROR_K,
+    READING_ERROR_V,
+    FIN,
+    ERROR,
+  };
+
+  explicit RpcPacketBuilder(JsonRpcPacket &p) : pkt { p } {
+    reset();
+  }
+
+  // C++ only needs the response status. Consume complete result/error-data
+  // values, including the empty arrays Lua emits for void returns.
+  bool skipValue(size_t children = 0) {
+    const bool result = state == WAIT_VALUE && current_key == Result;
+    const bool errorData = state == READING_ERROR_V && current_err_key == ErrorData;
+    if (!result && !errorData) return false;
+    if (ignoredItems == 0) ignoredItems = 1;
+    --ignoredItems;
+    if (children > maxRpcPacketBytes - ignoredItems) {
+      fail();
+      return true;
+    }
+    ignoredItems += children;
+    if (ignoredItems == 0) {
+      if (result) nextKey();
+      else finishErrorValue();
+    }
+    return true;
+  }
+
+  void handleInteger(int64_t value) {
+    if (skipValue()) return;
+    if (state == WAIT_KEY) {
+      if (value < JsonRpc::JsonRpc || value > Result || (seen_keys & (1u << (value - JsonRpc::JsonRpc)))) {
+        fail();
+        return;
+      }
+      seen_keys |= 1u << (value - JsonRpc::JsonRpc);
+      current_key = static_cast<int>(value);
+      state = WAIT_VALUE;
+    } else if (state == READING_ERROR_K) {
+      if (value < ErrorCode || value > ErrorData || (seen_error_keys & (1u << (value - ErrorCode)))) {
+        fail();
+        return;
+      }
+      seen_error_keys |= 1u << (value - ErrorCode);
+      current_err_key = static_cast<int>(value);
+      state = READING_ERROR_V;
+    } else if (state == WAIT_VALUE) {
+      switch ((JsonKeys)current_key) {
+        case Id:
+          if (value <= 0 || value > 10000000) {
+            fail();
+            return;
+          }
+          pkt.id = static_cast<int>(value);
+          nextKey();
+          break;
+        default:
+          fail();
+          break;
+      }
+    } else if (state == READING_ERROR_V) {
+      if (current_err_key == ErrorCode) {
+        if (value >= 0 || value < std::numeric_limits<int>::min()) {
+          fail();
+          return;
+        }
+        pkt.error.code = static_cast<int>(value);
+      } else {
+        fail();
+        return;
+      }
+
+      finishErrorValue();
+    } else if (state == READING_PARAMS) {
+      if (value >= std::numeric_limits<int>::min() && value <= std::numeric_limits<int>::max()) {
+        readParam((int)value);
+      } else {
+        readParam(value);
+      }
+    } else {
+      fail();
+    }
+  }
+
+  void handleBool(bool value) {
+    if (skipValue()) return;
+    if (state == READING_PARAMS) readParam(value);
+    else fail();
+  }
+
+  void handleNull() {
+    if (skipValue()) return;
+    if (state == READING_PARAMS) readParam(nullptr);
+    else fail();
+  }
+
+  void finishErrorValue() {
+    if (++error_value_readed == error_key_count) {
+      if ((seen_error_keys & 3u) != 3u) {
+        fail();
+        return;
+      }
+      nextKey();
+    } else {
+      state = READING_ERROR_K;
+    }
+  }
+
+  void handleBytes(const cbor_data data, size_t len) {
+    if (skipValue()) return;
+    if (state == WAIT_VALUE) {
+      std::string_view sv { (char *)data, len };
+      switch ((JsonKeys)current_key) {
+        case JsonRpc::JsonRpc:
+          if (sv != "2.0") {
+            fail();
+            return;
+          }
+          nextKey();
+          break;
+        case Method:
+          if (sv.empty()) {
+            fail();
+            return;
+          }
+          pkt.method = sv;
+          nextKey();
+          break;
+        default:
+          fail();
+          break;
+      }
+    } else if (state == READING_PARAMS) {
+      readParam(std::string_view { (char *)data, len });
+    } else if (state == READING_ERROR_V) {
+      if (current_err_key == ErrorMessage) {
+        pkt.error.message = std::string_view { (char *)data, len };
+      } else {
+        fail();
+        return;
+      }
+
+      finishErrorValue();
+    } else {
+      fail();
+    }
+  }
+
+  void startArray(size_t size) {
+    if (skipValue(size)) return;
+    if (!checkState(WAIT_VALUE)) return;
+    if (current_key != Params) {
+      fail();
+      return;
+    }
+
+    if (size > maxRpcPacketBytes) {
+      fail();
+      return;
+    }
+    param_count = size;
+    pkt.param_count = size;
+    if (size > 0) {
+      state = READING_PARAMS;
+    } else {
+      nextKey();
+    }
+  }
+
+  void startMap(size_t size) {
+    if (size > maxRpcPacketBytes / 2) {
+      fail();
+      return;
+    }
+    if (skipValue(size * 2)) return;
+    if (state == NOT_START) {
+      if (size < 2 || size > 4) {
+        fail();
+        return;
+      }
+      key_count = size;
+      state = WAIT_KEY;
+    } else if (state == WAIT_VALUE && current_key == Error) {
+      if (size < 2 || size > 3) {
+        fail();
+        return;
+      }
+      error_key_count = size;
+      state = READING_ERROR_K;
+    } else {
+      fail();
+    }
+  }
+
+  void reset() {
+    pkt.reset();
+    state = NOT_START;
+    key_count = 0;
+    param_count = 0;
+    current_param_idx = 0;
+    value_readed = 0;
+    error_value_readed = 0;
+  }
+
+  void nextKey() {
+    value_readed++;
+    if (value_readed == key_count) {
+      const auto has = [this](JsonKeys key) {
+        return (seen_keys & (1u << (key - JsonRpc::JsonRpc))) != 0;
+      };
+      if (!has(JsonRpc::JsonRpc) ||
+          (has(Method) && (has(Result) || has(Error))) ||
+          (!has(Method) && (has(Params) || (has(Result) && has(Error)) ||
+            (!has(Id) && !has(Error))))) {
+        fail();
+        return;
+      }
+      state = FIN;
+    } else {
+      state = WAIT_KEY;
+    }
+  }
+
+  void readParam(JsonRpcParam v) {
+    switch (current_param_idx) {
+      case 0:
+        pkt.param1 = v;
+        break;
+      case 1:
+        pkt.param2 = v;
+        break;
+      case 2:
+        pkt.param3 = v;
+        break;
+      case 3:
+        pkt.param4 = v;
+        break;
+      case 4:
+        pkt.param5 = v;
+        break;
+      default:
+        // Preserve the original parameter count for dispatcher validation.
+        // The print method intentionally consumes only the first five.
+        break;
+    }
+    current_param_idx++;
+    if (current_param_idx == param_count) {
+      nextKey();
+    }
+  }
+
+  void fail() { state = ERROR; }
+
+  bool checkState(State st) {
+    if (state == st) return true;
+    fail();
+    return false;
+  }
+
+  State state = NOT_START;
+  unsigned seen_keys = 0;
+  unsigned seen_error_keys = 0;
+  size_t key_count = 0;
+  size_t param_count = 0;
+  size_t ignoredItems = 0;
+  int current_key = 0;
+  size_t value_readed = 0;
+  size_t current_param_idx = 0;
+  size_t error_key_count = 0;
+  int current_err_key = 0;
+  size_t error_value_readed = 0;
+  JsonRpcPacket &pkt;
+};
+
+static struct cbor_callbacks callbacks = cbor_empty_callbacks;
+static std::once_flag callbacks_flag;
+
+static void init_callbacks() {
+  callbacks.uint8 = [](void* self, uint8_t value) {
+    static_cast<RpcPacketBuilder*>(self)->handleInteger(value);
+  };
+  callbacks.uint16 = [](void* self, uint16_t value) {
+    static_cast<RpcPacketBuilder*>(self)->handleInteger(value);
+  };
+  callbacks.uint32 = [](void* self, uint32_t value) {
+    static_cast<RpcPacketBuilder*>(self)->handleInteger(value);
+  };
+  callbacks.uint64 = [](void* self, uint64_t value) {
+    auto *builder = static_cast<RpcPacketBuilder*>(self);
+    if (builder->skipValue()) return;
+    if (value > static_cast<uint64_t>(std::numeric_limits<int64_t>::max())) builder->fail();
+    else builder->handleInteger(static_cast<int64_t>(value));
+  };
+  callbacks.negint8 = [](void* self, uint8_t value) {
+    static_cast<RpcPacketBuilder*>(self)->handleInteger(-1 - static_cast<int64_t>(value));
+  };
+  callbacks.negint16 = [](void* self, uint16_t value) {
+    static_cast<RpcPacketBuilder*>(self)->handleInteger(-1 - static_cast<int64_t>(value));
+  };
+  callbacks.negint32 = [](void* self, uint32_t value) {
+    static_cast<RpcPacketBuilder*>(self)->handleInteger(-1 - static_cast<int64_t>(value));
+  };
+  callbacks.negint64 = [](void* self, uint64_t value) {
+    auto *builder = static_cast<RpcPacketBuilder*>(self);
+    if (builder->skipValue()) return;
+    if (value > static_cast<uint64_t>(std::numeric_limits<int64_t>::max())) builder->fail();
+    else builder->handleInteger(-1 - static_cast<int64_t>(value));
+  };
+  callbacks.byte_string = [](void* self, const cbor_data data, uint64_t len) {
+    static_cast<RpcPacketBuilder*>(self)->handleBytes(data, len);
+  };
+  callbacks.array_start = [](void* self, uint64_t size) {
+    static_cast<RpcPacketBuilder*>(self)->startArray(size);
+  };
+  callbacks.map_start = [](void* self, uint64_t size) {
+    static_cast<RpcPacketBuilder*>(self)->startMap(size);
+  };
+  callbacks.null = [](void* self) { static_cast<RpcPacketBuilder*>(self)->handleNull(); };
+  const auto reject = [](void* self) { static_cast<RpcPacketBuilder*>(self)->fail(); };
+  callbacks.byte_string_start = reject;
+  callbacks.string_start = reject;
+  callbacks.indef_array_start = reject;
+  callbacks.indef_map_start = reject;
+  callbacks.indef_break = reject;
+  callbacks.undefined = reject;
+  callbacks.string = [](void* self, cbor_data, uint64_t) {
+    auto *builder = static_cast<RpcPacketBuilder*>(self);
+    if (!builder->skipValue()) builder->fail();
+  };
+  callbacks.tag = [](void* self, uint64_t) {
+    auto *builder = static_cast<RpcPacketBuilder*>(self);
+    if (!builder->skipValue(1)) builder->fail();
+  };
+  callbacks.float2 = callbacks.float4 = [](void* self, float) {
+    auto *builder = static_cast<RpcPacketBuilder*>(self);
+    if (!builder->skipValue()) builder->fail();
+  };
+  callbacks.float8 = [](void* self, double) {
+    auto *builder = static_cast<RpcPacketBuilder*>(self);
+    if (!builder->skipValue()) builder->fail();
+  };
+  callbacks.boolean = [](void* self, bool value) {
+    static_cast<RpcPacketBuilder*>(self)->handleBool(value);
+  };
+}
+
+static cbor_decoder_status readJsonRpcPacket(cbor_data &cbuf, size_t &len, JsonRpcPacket &packet) {
+  std::call_once(callbacks_flag, init_callbacks);
+  RpcPacketBuilder builder { packet };
+  auto cbufsave = cbuf;
+  auto lensave = len;
+
+  while (true) {
+    // 基于callbacks，边读缓冲区边构造packet并进一步调用回调处理packet
+    // 下面这个函数一次只读一个item
+    auto decode_result = cbor_stream_decode(cbuf, len, &callbacks, &builder);
+
+    if (decode_result.read != 0) {
+      cbuf += decode_result.read;
+      len -= decode_result.read;
+    } else {
+      // NEDATA or ERROR
+      const size_t consumed = lensave - len;
+      cbuf = cbufsave;
+      len = lensave;
+      if (decode_result.required > maxRpcPacketBytes ||
+          consumed > maxRpcPacketBytes - decode_result.required)
+        return CBOR_DECODER_ERROR;
+      return decode_result.status;
+    }
+
+    if (lensave - len > maxRpcPacketBytes) {
+      cbuf = cbufsave;
+      len = lensave;
+      return CBOR_DECODER_ERROR;
+    }
+    if (builder.state == RpcPacketBuilder::FIN) return CBOR_DECODER_FINISHED;
+    if (builder.state == RpcPacketBuilder::ERROR) {
+      cbuf = cbufsave;
+      len = lensave;
+      return CBOR_DECODER_ERROR;
+    }
+  }
+}
+
+// Keep decoded string views alive throughout dispatch, including nested waits.
+// An incomplete packet leaves the input buffer untouched.
+cbor_decoder_status takeRpcPacket(std::vector<unsigned char> &input,
+    std::vector<unsigned char> &packetStorage, JsonRpcPacket &packet) {
+  if (input.empty()) return CBOR_DECODER_NEDATA;
+  auto cursor = static_cast<cbor_data>(input.data());
+  size_t remaining = input.size();
+  auto status = readJsonRpcPacket(cursor, remaining, packet);
+  if (status == CBOR_DECODER_FINISHED) {
+    std::vector<unsigned char> tail(cursor, cursor + remaining);
+    packetStorage.swap(input);
+    input.swap(tail);
+  }
+  return status;
+}
