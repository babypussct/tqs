+void Room::clearFailedWorkerRefs() {
+  {
+    std::lock_guard<std::mutex> locker(lua_ref_mutex);
+    lua_ref_count = 0;
+  }
+  auto &um = Server::instance().user_manager();
+  const auto resetPlayer = [&](int connId) {
+    auto player = um.findPlayerByConnId(connId).lock();
+    if (!player) return;
+    player->getRouter().abortRequest();
+    player->setThinking(false);
+    if (player->isOnline()) {
+      player->setRunned(false);
+      player->setState(Player::Online);
+    }
+  };
+  for (auto connId : players) resetPlayer(connId);
+  for (auto connId : observers) resetPlayer(connId);
+}
