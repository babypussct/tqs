new file mode 100644
--- /dev/null
+++ b/src/server/account_tempban.h
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <chrono>
+#include <optional>
+#include <unordered_map>
+
+class AccountTempBanStore {
+public:
+  using clock = std::chrono::steady_clock;
+  using time_point = clock::time_point;
+
+  std::optional<time_point> apply(int accountId, std::chrono::minutes duration,
+                                  time_point now = clock::now()) {
+    if (accountId <= 0 || duration <= std::chrono::minutes::zero())
+      return std::nullopt;
+
+    const auto until = now + duration;
+    auto it = bans.find(accountId);
+    if (it == bans.end() || it->second < until)
+      bans[accountId] = until;
+    return bans.at(accountId);
+  }
+
+  bool contains(int accountId, time_point now = clock::now()) {
+    auto it = bans.find(accountId);
+    if (it == bans.end()) return false;
+    if (it->second <= now) {
+      bans.erase(it);
+      return false;
+    }
+    return true;
+  }
+
+  void removeIfExpired(int accountId, time_point now = clock::now()) {
+    auto it = bans.find(accountId);
+    if (it != bans.end() && it->second <= now)
+      bans.erase(it);
+  }
+
+private:
+  std::unordered_map<int, time_point> bans;
+};

