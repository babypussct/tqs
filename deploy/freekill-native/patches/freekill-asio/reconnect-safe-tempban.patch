+std::weak_ptr<ServerPlayer> UserManager::findPlayer(int id, bool preferInGame) const {
   if (id < 0) return findRobot(id);
+  if (preferInGame) {
+    std::shared_ptr<ServerPlayer> offlinePlayer;
+    for (const auto &entry : players_map) {
+      const auto &player = entry.second;
+      if (!player || player->getId() != id || !player->insideGame()) continue;
+      // A stale Run player must win over an Offline duplicate so an old
+      // abandonment record cannot be bypassed by reconnecting another
+      // in-game object for the same authenticated account.
+      if (player->getState() != ServerPlayer::Offline)
+        return player;
+      if (!offlinePlayer)
+        offlinePlayer = player;
+    }
+    if (offlinePlayer)
+      return offlinePlayer;
+  }
   try {
     return online_players_map.at(id);
   } catch (const std::out_of_range &) {
     return {};
   }
 }
