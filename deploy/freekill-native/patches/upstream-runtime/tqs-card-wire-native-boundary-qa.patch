+void recordNativeWireBoundary(std::string_view message) {
+  bool decoded = false;
+  bool cardWireCommand = false;
+  std::string channel = "other";
+  cbor_load_result result {};
+  auto *item = cbor_load(
+    reinterpret_cast<const cbor_data>(message.data()), message.size(), &result);
