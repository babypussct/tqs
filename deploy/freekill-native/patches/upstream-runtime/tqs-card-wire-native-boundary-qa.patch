+bool nativeWireOpaqueReference(std::string_view value) {
+  if (value.size() < 18 || value.size() > 128 || value.substr(0, 2) != "h:") return false;
+  for (const auto byte : value.substr(2)) {
+    if (!((byte >= 'a' && byte <= 'z') || (byte >= 'A' && byte <= 'Z') ||
+          (byte >= '0' && byte <= '9') || byte == '_' || byte == '-')) return false;
+  }
+  return true;
+}
