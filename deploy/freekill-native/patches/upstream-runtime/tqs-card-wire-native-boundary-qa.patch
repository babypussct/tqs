+void auditNativeWireSemanticNode(
+  const cbor_item_t *item,
+  bool referenceContext,
+  bool referenceMapKeyContext,
+  bool nestedCbor,
+  size_t depth,
+  NativeWireSemanticAudit &audit) {
+  if (item == nullptr || audit.budgetExceeded) return;
+  if (++audit.nodes > 50000 || depth > 64) {
+    audit.budgetExceeded = true;
+    return;
+  }
+  audit.maxDepth = std::max(audit.maxDepth, depth);
+
+  if (cbor_isa_bytestring(item) || cbor_isa_string(item)) {
+    const auto length = cbor_isa_bytestring(item)
+      ? cbor_bytestring_length(item) : cbor_string_length(item);
+    const auto *data = cbor_isa_bytestring(item)
+      ? cbor_bytestring_handle(item) : cbor_string_handle(item);
+    const std::string_view value = data == nullptr
+      ? std::string_view {} : std::string_view {
+        reinterpret_cast<const char *>(data), length };
+    if (nestedCbor) {
+      cbor_load_result result {};
+      auto *nested = cbor_load(
+        reinterpret_cast<const cbor_data>(value.data()), value.size(), &result);
+      if (nested == nullptr) {
+        audit.invalidReferences++;
+      } else {
+        audit.nestedDecoded++;
+        auditNativeWireSemanticNode(nested, false, true, false, depth + 1, audit);
+        cbor_decref(&nested);
+      }
+      return;
+    }
+    if (referenceContext || referenceMapKeyContext) {
+      if (nativeWireOpaqueReference(value)) audit.opaqueReferences++;
+      else audit.invalidReferences++;
+    }
+    return;
+  }
+  if (cbor_is_int(item)) {
+    if (referenceContext || referenceMapKeyContext) audit.numericReferences++;
+    return;
+  }
+  if (cbor_isa_tag(item)) {
+    auditNativeWireSemanticNode(cbor_tag_item(item), referenceContext,
+      referenceMapKeyContext, nestedCbor, depth + 1, audit);
+    return;
+  }
+  if (cbor_isa_array(item)) {
+    audit.arrays++;
+    const auto size = cbor_array_size(item);
+    if (size > 8192) { audit.budgetExceeded = true; return; }
+    for (size_t index = 0; index < size; ++index) {
+      auditNativeWireSemanticNode(cbor_array_handle(item)[index], referenceContext,
+        false, false, depth + 1, audit);
+    }
+    return;
+  }
+  if (cbor_isa_map(item)) {
+    audit.maps++;
+    const auto size = cbor_map_size(item);
+    if (size > 8192) { audit.budgetExceeded = true; return; }
+    const auto *pairs = cbor_map_handle(item);
+    for (size_t index = 0; index < size; ++index) {
+      const auto &pair = pairs[index];
+      bool childReferenceContext = referenceContext;
+      bool childReferenceMapKeyContext = false;
+      bool childNestedCbor = false;
+      if (cbor_isa_bytestring(pair.key) || cbor_isa_string(pair.key)) {
+        const auto length = cbor_isa_bytestring(pair.key)
+          ? cbor_bytestring_length(pair.key) : cbor_string_length(pair.key);
+        const auto *data = cbor_isa_bytestring(pair.key)
+          ? cbor_bytestring_handle(pair.key) : cbor_string_handle(pair.key);
+        const std::string_view key = data == nullptr
+          ? std::string_view {} : std::string_view {
+            reinterpret_cast<const char *>(data), length };
+        if (referenceMapKeyContext) {
+          if (nativeWireOpaqueReference(key)) audit.opaqueReferences++;
+          else audit.invalidReferences++;
+        }
+        childReferenceContext = childReferenceContext || nativeWireReferenceField(key);
+        childReferenceMapKeyContext = key == "card_marks" || key == "visible_data";
+        childNestedCbor = key == "card_marks";
+        if (nativeWireForbiddenField(key)) audit.forbiddenFields++;
+      } else if (referenceMapKeyContext && cbor_is_int(pair.key)) {
+        audit.numericReferences++;
+      }
+      auditNativeWireSemanticNode(pair.value, childReferenceContext,
+        childReferenceMapKeyContext, childNestedCbor, depth + 1, audit);
+    }
+  }
+}
