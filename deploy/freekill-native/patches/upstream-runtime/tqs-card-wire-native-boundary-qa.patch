+void appendNativeWireSemanticRecord(
+  std::string_view scope,
+  std::string_view command,
+  std::string_view payload,
+  ServerPlayer *player,
+  bool outerPacket) {
+  const std::string channel = scope == "inbound-reply"
+    ? "reply" : nativeWireSerializationChannel(command);
+  if (channel == "other") return;
+  auto &metrics = nativeWireSemanticMetrics();
+  if (metrics.path.empty()) return;
+  // Client replies do not carry a trusted command label in every native
+  // packet shape.  Retain only the bounded reply class, never that label.
+  const std::string_view safeCommand = scope == "inbound-reply" ? "Reply" : command;
+
+  NativeWireSemanticAudit audit;
+  bool outerDecoded = !outerPacket;
+  std::string_view innerPayload = payload;
+  cbor_item_t *outer = nullptr;
+  if (outerPacket) {
+    cbor_load_result result {};
+    outer = cbor_load(
+      reinterpret_cast<const cbor_data>(payload.data()), payload.size(), &result);
+    outerDecoded = outer != nullptr && cbor_isa_array(outer) && cbor_array_size(outer) >= 4;
+    if (outerDecoded) {
+      const auto *data = cbor_array_get(outer, 3);
+      if (data != nullptr && cbor_isa_bytestring(data)) {
+        const auto length = cbor_bytestring_length(data);
+        const auto *bytes = cbor_bytestring_handle(data);
+        if (bytes == nullptr && length != 0) {
+          outerDecoded = false;
+        } else if (length == 0) {
+          innerPayload = std::string_view {};
+        } else {
+          innerPayload = std::string_view {
+            reinterpret_cast<const char *>(bytes), length };
+        }
+      } else {
+        outerDecoded = false;
+      }
+    }
+  }
+  cbor_load_result innerResult {};
+  auto *inner = cbor_load(
+    reinterpret_cast<const cbor_data>(innerPayload.data()), innerPayload.size(), &innerResult);
+  audit.innerDecoded = inner != nullptr;
+  if (inner != nullptr) {
+    auditNativeWireSemanticNode(inner, false, false, false, 0, audit);
+    cbor_decref(&inner);
+  }
+  if (outer != nullptr) cbor_decref(&outer);
+
+  std::lock_guard lock(metrics.mutex);
+  if (metrics.records >= 8192) return;
+  std::ofstream output(metrics.path, std::ios::app);
+  if (!output) return;
+  output << "{\"schemaVersion\":1,\"scope\":\"" << scope
+         << "\",\"command\":\"" << safeCommand
+         << "\",\"channel\":\"" << channel
+         << "\",\"audience\":\"" << nativeWireSemanticAudience(player)
+         << "\",\"outerDecoded\":" << (outerDecoded ? "true" : "false")
+         << ",\"innerDecoded\":" << (audit.innerDecoded ? "true" : "false")
+         << ",\"semanticPass\":" <<
+            (outerDecoded && audit.innerDecoded && !audit.budgetExceeded &&
+             audit.invalidReferences == 0 && audit.forbiddenFields == 0 ? "true" : "false")
+         << ",\"nodes\":" << audit.nodes
+         << ",\"maps\":" << audit.maps
+         << ",\"arrays\":" << audit.arrays
+         << ",\"opaqueReferences\":" << audit.opaqueReferences
+         << ",\"numericReferences\":" << audit.numericReferences
+         << ",\"invalidReferences\":" << audit.invalidReferences
+         << ",\"forbiddenFields\":" << audit.forbiddenFields
+         << ",\"nestedDecoded\":" << audit.nestedDecoded
+         << ",\"maxDepth\":" << audit.maxDepth << "}\n";
+  metrics.records++;
+}
