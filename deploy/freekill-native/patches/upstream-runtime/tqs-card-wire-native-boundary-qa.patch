+std::string nativeWireSemanticAudience(ServerPlayer *player) {
+  if (player == nullptr) return "unknown";
+  const auto roomBase = player->getRoom().lock();
+  const auto room = std::dynamic_pointer_cast<Room>(roomBase);
+  if (!room) return "unknown";
+  if (room->hasObserver(*player)) return "observer";
+  const auto owner = room->getOwner().lock();
+  return owner && owner.get() == player ? "owner" : "opponent";
+}
