+void appendNativeWireSerializationTiming(
+  std::string_view scope,
+  std::string_view channel,
+  long long elapsedNanoseconds,
+  size_t wireBytes) {
+  auto &metrics = nativeWireSerializationMetrics();
+  if (metrics.path.empty() || channel == "other") return;
+
+  std::lock_guard lock(metrics.mutex);
+  // A bounded sample is enough for QA distribution checks and prevents an
+  // accidentally long room from turning the hook into an unbounded log sink.
+  if (metrics.records >= 4096) return;
+  std::ofstream output(metrics.path, std::ios::app);
+  if (!output) return;
+  output << "{\"schemaVersion\":1,\"scope\":\"" << scope
+         << "\",\"channel\":\"" << channel
+         << "\",\"elapsedNs\":" << std::max(0LL, elapsedNanoseconds)
+         << ",\"wireBytes\":" << wireBytes << "}\n";
+  metrics.records++;
+}
