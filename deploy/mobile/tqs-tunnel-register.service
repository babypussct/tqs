[Unit]
Description=Register the current Oracle Quick Tunnel in Cloudflare Pages KV
Wants=network-online.target
After=network-online.target tqs-quick-tunnel.service tqs-gateway.service

[Service]
Type=oneshot
User=root
ExecStart=/home/ubuntu/.local/opt/node22/bin/node /home/ubuntu/tqs-gateway/tunnel-register.mjs
StateDirectory=tqs-tunnel-register
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
