# Client Environment Variables (Vite)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
# Optional Firebase Web SDK overrides for isolated Preview/staging projects.
# When empty, firebase-applet-config.json remains the production fallback.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_ID=

# Backend / API Environment Variables
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_SETUP_SECRET=
# Optional comma-separated Telegram numeric user IDs allowed to run admin commands.
TELEGRAM_ALLOWED_USER_IDS=

# Firebase Admin / Service Account (for local test or server runtime)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Cloudflare Worker / Storage (Phase 5)
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_CUSTOM_DOMAIN=
