    "test:connection": "tsx --test scripts/connection.test.ts",
    "test:messages": "tsx --test scripts/connection-messages.test.ts",
    "test:gameplay": "tsx --test scripts/gameplay.test.ts",
    "test:choices": "tsx --test scripts/choices.test.ts",
    "test:store": "tsx --test scripts/store.test.ts",
    "test:initial-general": "tsx --test scripts/initial-general-choice.test.ts",
    "test:bundle": "tsx --test scripts/bundle.test.ts",
    "test:e2e": "tsx scripts/browser-e2e/run.ts",
