    "test:e2e:pwa": "tsx scripts/pwa-e2e/run.ts",
    "test:e2e:auth-popup": "tsx scripts/auth-popup-e2e/run.ts",
    "test:e2e:public": "tsx scripts/public-oauth-e2e/run.ts",
    "test:e2e:public:unit": "tsx --test scripts/public-oauth-e2e/contract.test.ts",
    "test:auth-routing": "tsx --test scripts/google-auth-routing.test.ts && node --test scripts/google-auth-helper.test.mjs",
    "test:lua-lifecycle": "tsx --test scripts/lua-lifecycle.test.ts",
