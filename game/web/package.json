{
  "name": "tqs-game-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-wasm.mjs",
    "dev": "vite --host 0.0.0.0 --port 5174",
    "prebuild": "node scripts/prepare-wasm.mjs",
    "build": "npm run audit:skills && npm run audit:native-callers && tsc --noEmit && vite build && node scripts/build-service-worker.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 5174",
    "typecheck": "tsc --noEmit",
    "audit:skills": "tsx scripts/skill-audit.ts",
    "audit:native-callers": "tsx scripts/native-caller-audit.ts",
    "extract:skills:zh": "tsx scripts/skill-zh-source.ts --markdown",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:live": "tsx scripts/smoke.ts --live",
    "test:recovery": "tsx --test scripts/recovery.test.ts",
    "test:protocol": "tsx --test scripts/protocol.test.ts",
    "test:connection": "tsx --test scripts/connection.test.ts",
    "test:gameplay": "tsx --test scripts/gameplay.test.ts",
    "test:choices": "tsx --test scripts/choices.test.ts",
    "test:store": "tsx --test scripts/store.test.ts",
    "test:bundle": "tsx --test scripts/bundle.test.ts",
    "test:e2e": "tsx scripts/browser-e2e/run.ts",
    "test:e2e:lua": "tsx scripts/real-lua-e2e/run.ts",
    "test:e2e:qa": "tsx scripts/real-lua-e2e/run.ts --qa-scenarios",
    "test:e2e:live": "tsx scripts/live-gateway-e2e/run.ts",
    "configure:live": "tsx scripts/live-gateway-e2e/configure.ts",
    "test:live-config": "tsx --test scripts/live-gateway-e2e/snapshot.test.ts",
    "test:e2e:login": "tsx scripts/live-gateway-e2e/run.ts --login",
    "test:card-selection": "tsx --test scripts/card-selection.test.ts",
    "test:cards-and-choice": "tsx --test scripts/cards-and-choice.test.ts",
    "test:native-dialogs": "tsx --test scripts/native-dialogs.test.ts",
    "test:room-pools": "tsx --test scripts/room-pools.test.ts",
    "test:vietnamese": "tsx --test scripts/vietnamese-l01.test.ts",
    "test:e2e:multiplayer": "tsx scripts/multiplayer-e2e/run.ts",
    "test:e2e:pwa": "tsx scripts/pwa-e2e/run.ts",
    "test:lua-lifecycle": "tsx --test scripts/lua-lifecycle.test.ts",
    "test:release": "node --test ../../deploy/mobile/release.test.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "node-forge": "^1.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "wasmoon": "^1.16.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/node-forge": "^1.3.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "playwright-core": "^1.64.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
