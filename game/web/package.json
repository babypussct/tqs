    "test:card-effects": "tsx --test scripts/card-effects.test.ts",
    "test:cards-and-choice": "tsx --test scripts/cards-and-choice.test.ts",
    "test:native-dialogs": "tsx --test scripts/native-dialogs.test.ts",
