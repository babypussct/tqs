    "test:prompt4:provenance": "tsx --test scripts/smart-ai-prompt4-provenance.test.ts",
    "test:prompt4:native-replay": "tsx --test scripts/smart-ai-prompt4-native-replay.test.ts",
    "test:prompt4:native-skill-trace": "tsx --test scripts/smart-ai-prompt4-native-skill-trace.test.ts",
    "test:prompt4:chooser-native-replay": "tsx --test scripts/smart-ai-prompt4-chooser-native-replay.test.ts",
    "test:prompt4:request-safety-review": "tsx --test scripts/smart-ai-prompt4-request-safety-review.test.ts",
    "test:prompt4:request-safety-followup": "tsx --test scripts/smart-ai-prompt4-request-safety-followup.test.ts",
    "test:prompt4:chooser-paired": "tsx --test scripts/smart-ai-prompt4-chooser-paired.test.ts",
    "test:general-pair-winrate": "tsx --test scripts/general-pair-winrate.test.ts",
    "run:general-pair-winrate": "tsx scripts/general-pair-winrate.ts",
    "test:release": "node --test ../../deploy/mobile/release.test.mjs",
    "audit:translations": "tsx scripts/translation-inventory.ts"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "firebase": "12.8.0",
    "node-forge": "1.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "wasmoon": "^1.16.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/node-forge": "^1.3.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "playwright-core": "^1.64.0",
    "tsx": "^4.21.0",
