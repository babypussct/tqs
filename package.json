{
  "name": "tqs-shop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "codex:resume": "node scripts/codex-checkpoint.mjs --show",
    "codex:checkpoint": "node scripts/codex-checkpoint.mjs --update",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node build/shop.mjs build",
    "check:build": "node build/shop.mjs check",
    "verify:vercel": "node build/verify-vercel.mjs",
    "test:build-safety": "node --test build/output-policy.test.mjs",
    "test:pipelines": "node --test build/change-scopes.test.mjs",
    "changes:plan": "node build/change-scopes.mjs",
    "preview": "vite preview",
    "clean": "node build/shop.mjs clean",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "npm run typecheck && npm --prefix game/web run typecheck && npm --prefix game/web run typecheck:tools",
    "lint": "npm run typecheck",
    "test:order": "tsx src/order/contract.test.ts && tsx src/order/service.test.ts && tsx src/order/pricing.test.ts",
    "test:media": "tsx src/media/mediaPolicy.test.ts",
    "test:auth": "tsx src/utils/googleAuthFlow.test.ts",
    "test:e2e:auth": "node scripts/shop-auth-e2e.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-tqs \"tsx tests/firestore.rules.test.ts\"",
    "test": "npm run test:order && npm run test:media",
    "test:all": "npm run test && npm run test:rules",
    "firebase:dry-run": "firebase deploy --project production --only firestore:rules,firestore:indexes --dry-run",
    "firebase:deploy": "firebase deploy --project production --only firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1137.0",
    "@aws-sdk/s3-request-presigner": "^3.1137.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tiptap/extension-color": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-table-cell": "^3.31.3",
    "@tiptap/extension-table-header": "^3.31.3",
    "@tiptap/extension-table-row": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/extension-youtube": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "dompurify": "^3.4.16",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.7.4",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "ajv": "^8.20.0",
    "path-to-regexp": "^6.3.0",
    "undici": "^6.29.0",
    "esbuild": "0.27.2"
  }
}
